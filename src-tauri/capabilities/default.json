{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Google Messages",
  "windows": ["main", "settings", "popover"],
  "remote": {
    "urls": [
      "https://messages.google.com/*",
      "https://accounts.google.com/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "opener:default",
    "allow-set-tray-badge",
    "allow-open-external",
    "allow-get-settings",
    "allow-set-settings",
    "allow-open-settings",
    "allow-focus-main-window",
    "allow-adjust-zoom",
    "allow-send-native-notification",
    "allow-close-native-notification",
    "allow-clear-native-notifications",
    "allow-report-heartbeat",
    "allow-set-session-yielded",
    "allow-prompt-takeover-session",
    "allow-press-enter-key",
    "allow-log-page-diagnostic",
    "allow-set-recent-conversations",
    "allow-set-connection-state",
    "allow-get-popover-state",
    "allow-popover-action",
    "allow-popover-action-done",
    "allow-hide-popover",
    "allow-set-popover-height"
  ]
}
